# Code Along environment
# Copy to .env.local and fill in the keys you have.

# Optional. Featured demos + Open-editor OCR do not need this.
# https://console.x.ai
XAI_API_KEY=
# Cheap default is grok-4-1-fast-non-reasoning (~$0.20/$0.50 per 1M).
XAI_MODEL=grok-4-1-fast-non-reasoning

# Writable data dir. Vercel uses /tmp automatically. Droplet uses ./data (volume).
# DATA_DIR=/app/data

# --- Optional: secure multi-language sandbox (https://e2b.dev) ---
# Without this, Python runs in Pyodide and JS in a Web Worker.
E2B_API_KEY=

# Optional live-OCR host. Leave unset while the DigitalOcean droplet is off.
# When it is back: CAPTURE_BACKEND_URL=https://status.neel.world/codealong-ocr
# CAPTURE_BACKEND_URL=

# --- Screen extract ---
# ffmpeg + tesseract (already common on macOS via brew)
# pip3 install yt-dlp pillow
# Deno (for YouTube JS challenges): curl -fsSL https://deno.land/install.sh | sh
# First Open-editor downloads a 12s window, then later timestamps are ffmpeg seek + OCR.
# Chrome cookies only help on the Mac. Do not set this on the droplet.
# YTDLP_COOKIES_FROM_BROWSER=chrome
